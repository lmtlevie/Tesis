                        Direction = Right
                        Color = 15
                        Icon = %quantum%h.svg
                        }
                    Parameters
                        {
                        Processing time = Str; 0.1 ; 
                        }
                    }
                Atomic
                    {
                    Name = Measure0
                    Ports = 1 ; 2
                    Path = quantum\measure.h
                    Description = Measures the qubit. Output port 0 means result 0; output port 1 means result 1.
                    Graphic
                        {
                        Position = -6030 ; -3255
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %quantum%measure.svg
                        }
                    Parameters
                        {
                        Processing time = Str; 0.1 ; 
                        Random seed = Str; 0 ; 
                        }
                    }
                Atomic
                    {
                    Name = Event Counter0
                    Ports = 2 ; 2
                    Path = sinks/ev_count2.h
                    Description = Counts events received at each port. Port 0 counts zeros; port 1 counts ones.
                    Graphic
                        {
                        Position = -4485 ; -3255
                        Dimension = 720 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%coun_ev.bmp
                        }

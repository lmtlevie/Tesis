                        Inputs = Str; %Inputs ; Number of Inputs
                        }
                    }
                Atomic
                    {
                    Name = GnuPlot0
                    Ports = 2 ; 0
                    Path = sinks/gnuplot.h
                    Description = Plots accumulated measurement counts.
                    Graphic
                        {

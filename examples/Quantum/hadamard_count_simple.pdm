                    Parameters
                        {
                        Inputs = Str; %Inputs ; Number of inputs
                        Format = Str; set xrange [0:%tf] @ set yrange [0:100] @ set ytics 0,10,100 @ set grid ytics @ set xlabel 'simulation time' @ set ylabel 'accumulated count' @ set title 'Hadamard measurement counts' ; General Formatting (use @ as line break)
                        Format1 = Str; with steps lw 2 lc rgb '#1f77b4' title '0 count' ; Formatting options for input 1
                        Format2 = Str; with steps lw 2 lc rgb '#d62728' title '1 count' ; Formatting options for input 2
                        Format3 = Str;  ; Formatting options for input 3
                        Format4 = Str;  ; Formatting options for input 4
                        Format5 = Str;  ; Formatting options for input 5
                        }
                    }

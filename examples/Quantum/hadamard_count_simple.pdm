                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %quantum%quantum.svg
                        }
                    Parameters
                        {
                        Number of qubits = Str; 1 ;
                        Shots = Str; 100 ;
                        Shot period = Str; 1 ;
                        }
                    }
                Atomic
                    {
                    Name = Q Zero0
                    Ports = 0 ; 1
                    Path = quantum\qzero.h
                    Description = Emits qubit 0 initialized to |0>.
                    Graphic
                        {
                        Position = -9000 ; -3300
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %quantum%qzero.svg
                        }
                    Parameters
                        {
                        Qubit index = Str; -1 ;
                        }
                    }
                Atomic
                    {
                    Name = H0
                    Ports = 1 ; 1
                    Path = quantum\h.h
                    Description = Hadamard gate on the only qubit.
                    Graphic
                        {
                        Position = -7500 ; -3300
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %quantum%h.svg
                        }
                    Parameters
                        {
                        Processing time = Str; 0.1 ;
                        }
                    }
                Atomic
                    {
                    Name = Measure0
                    Ports = 1 ; 2
                    Path = quantum\measure.h
                    Description = Measures the qubit. Output port 0 means result 0; output port 1 means result 1.
                    Graphic
                        {
                        Position = -6000 ; -3300
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %quantum%measure.svg
                        }
                    Parameters
                        {
                        Processing time = Str; 0.1 ;
                        Random seed = Str; 0 ;
                        }
                    }
                Atomic
                    {
                    Name = Event Counter0
                    Ports = 2 ; 0
                    Path = sinks/ev_count2.h
                    Description = Counts events received at each port. Port 0 counts zeros; port 1 counts ones.
                    Graphic
                        {
                        Position = -4500 ; -3300
                        Dimension = 720 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%coun_ev.bmp
                        }
                    Parameters
                        {

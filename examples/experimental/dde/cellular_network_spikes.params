#### Parameters for the simulator  ####
tf = 5      # set default final time (can be overriden by command line -tf)
# ti = 10     # Set initial time to t (double format).
# i = 0       # Run interactive shell.
b = 1000000   # Stop simulation after n steps in the same time (to detect illegitimate models).
# d = 0       # Debug simulation.
# rt = 0      # Synchronize events with real time.

ExperimentNumber = 0 # RunNumber is used for scanning parameters defined in ParameterValues. The value to be used is ParameterValues[ExperimentNumber]. It can be overriden by a commandLine parameter.

# Backends
parameter_reading_backend = CmdLine  # (CmdLine or Scilab) - Backend to be used for reading parameters in atomic models
variable_logging_backend  = hdf5      # (hdf5, csv or Scilab) - Backend to be used for logging variables in atomic models

# General
StochasticSimu = 0 # 1=YES (use STEVS), 0=NO (use means as constant values).
SimulationName = cellular_network_spikes

# Levels for logging of variables time-series, and for debug messages in the logfile 
logLevel=999999999 # how many time-series variables are saved. full debug (very slow, hugefiles) = 99999999 
debugLevel=9999999 # how much detail to include in debug logs pdevs_run.log. full debug (very slow, hugefiles) = 99999999

# Model behavior
X0_0 =  0.5
X1_0 = -0.5
void FluidFlowRoutingTable::defineRoutes(){
	// Flow names must be defined in the CmdLine configuration (PD<->Scilab can not read strings)
	auto flowNames =  getCmdLineParam<std::vector<std::string>>("FlowIds");

	std::string flowName;
	for(uint flowIndex=0; flowIndex<flowNames.size(); flowIndex++){
		flowName = flowNames[flowIndex];
//		DemuxPorts[flowName] = flowIndex; // add flowName

		// create the route from CmdLine config
		auto routeNames =  getCmdLineParam<std::vector<std::string>>(flowName + ".routeNames");
		auto routePorts =  getCmdLineParam<std::vector<int>>(flowName + ".routePorts");
		if(routeNames.size() != routePorts.size()){
			throw std::runtime_error("ERROR: Parameters '"+flowName + ".routeNames' and '"+flowName + ".routePorts' must be of the same size.");
		}

		// add entries to the routing table
		for(uint i=0; i<routeNames.size(); i++){
			RoutingTable[routeNames[i]][flowName] = routePorts[i];
		}
	}
}





#include "FluidFlowRoutingTable.h"

std::map<std::string, map<std::string, int>> FluidFlowRoutingTable::RoutingTable;
//std::map<std::string, int> FluidFlowRoutingTable::DemuxPorts;


int FluidFlowRoutingTable::getOutgoingPort(const std::string& nodeName, const std::string& flowId /*, int inputPort*/){
	if(RoutingTable.empty()) {// call just once (unless it does not define any flows...)
		defineRoutes();
	}

	auto searchNode = RoutingTable.find(nodeName);
	if ( searchNode == RoutingTable.end() ) { // not found
		throw std::runtime_error("FluidFlowRoutingTable::getOutgoingPort - '" + nodeName + "' is not defined in the routing table. Check the CmdLine configuration (routes can not be defined in scilab)"); // Flow names must be defined in the CmdLine configuration (PD<->Scilab can not read strings)
	}

	auto searchFlow= searchNode->second.find(flowId);
	if ( searchFlow == searchNode->second.end() ) { // not found
		throw std::runtime_error("'" + flowId + "' flow is not defined in the routing table for node '"+ nodeName +"'. Check the CmdLine configuration (routes can not be defined in scilab)"); // Flow names must be defined in the CmdLine configuration (PD<->Scilab can not read strings)
	}

	return searchFlow->second;
}


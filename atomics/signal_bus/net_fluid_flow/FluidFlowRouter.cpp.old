#include "FluidFlowRouter.h"

void FluidFlowRouter::init(double t, ...) {
	BaseSimulator::init(t);

	//The 'parameters' variable contains the parameters transferred from the editor.
	va_list parameters;
	va_start(parameters, t);

	this->sigma = std::numeric_limits<double>::max(); // Immediately asks for a new packet

	//	this->logger->initSignals({
	//		{"sent_bits", SCILAB_LOG_LEVEL_ALWAYS},
	//		{"sent_packets", SCILAB_LOG_LEVEL_PRIORITY},
	//		{"processingTime", SCILAB_LOG_LEVEL_DEBUG},
	//	});
}

void FluidFlowRouter::dint(double t) {
	this->sigma = std::numeric_limits<double>::infinity();
	if(!this->pendingFlows.empty()){
		this->sigma =0; // program transition immediately
	}
}

void FluidFlowRouter::dext(Event x, double t) {
	auto arrivedFlow = castEventPointer<FluidFlow>(x); // get the flow from the incoming event
//	int inPort = x.port; // save the inport for routing decision

	this->pendingFlows.push_back(arrivedFlow);
	this->sigma = 0; // program transition immediately
}

Event FluidFlowRouter::lambda(double t) {
	auto flow = this->pendingFlows.front();
	this->pendingFlows.pop_front();

	int port = FluidFlowRoutingTable::getOutgoingPort(this->father->getFullName(), flow->flowId.value);

	debugMsg(LOG_LEVEL_DEBUG, "[%g] %s::FluidFlowRouter::lambda:  flowID=%s sent through output port=%i  \n", t, this->getFullName().data(), flow->flowId.value.data(), port);

	return Event(flow, port);
}


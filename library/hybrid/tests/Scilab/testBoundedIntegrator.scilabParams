stepTimeChanges = [0, 1              , 3                    , 5                   , 7];                   
stepValueChanges =[0, maxValue, -maxValue*2 , maxValue*2, -maxValue];                      
stepValueChanges1 = zeros(stepValueChanges);                   
stepValueChanges2 = zeros(stepValueChanges);
stepValueChanges3 = zeros(stepValueChanges);


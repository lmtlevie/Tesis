                                                                                                                                                                                                                {
                                                                                                                                                                                                                }
                                                                                                                                                                                                            }
                                                                                                                                                                                                        Atomic
                                                                                                                                                                                                            {
                                                                                                                                                                                                            Name = sharedBuffer
                                                                                                                                                                                                            Ports = 6 ; 3
                                                                                                                                                                                                            Path = network/packetSharedQueue.h
                                                                                                                                                                                                            Description = * Represents a shared buffered within a switch/router.\n * There is a fixed buffer per port (per_port_capacity_bits), which is used only by packets destined to that port (same as several packetQueue.cpp)\n * Additional, there is a shared buffered (shared_capacity_bits), which is used by all packets which does not fit in their corresponding fixed queue.\n * Packets are discarded if 1) the fixed buffer is full AND 2) the shared buffer is full\n * Packets are always severed in a FIFO order respecting egress ports request orders. Once a packet is in a given buffer (fixed or shared) stays in that same buffer until sent\n *\n *\n * In port <N (even) > (0,2,4,...): request to dequeue from egress port N/2\n * In port <M (odd) (1,3,5,...: packet destined to egress port N-1/2\n *\n * Outport P: packet sent to egress port P
                                                                                                                                                                                                            Graphic
                                                                                                                                                                                                                {
                                                                                                                                                                                                                Position = -2850 ; 4680
                                                                                                                                                                                                                Dimension = 1350 ; 1290
                                                                                                                                                                                                                Direction = Right
                                                                                                                                                                                                                Color = 15
                                                                                                                                                                                                                Icon = %datanetworks%priorityqueue.jpg
                                                                                                                                                                                                                }
                                                                                                                                                                                                            Parameters
                                                                                                                                                                                                                {
                                                                                                                                                                                                                per_port_capacity_bits = Str; %per_port_capacity_bits ; Capacity of the fixed per port buffer
                                                                                                                                                                                                                shared_capacity_bits = Str; %shared_capacity_bits ; Capacity of the shared buffer
                                                                                                                                                                                                                buffer_cell_size_bits = Str; %buffer_cell_size_bits ; The cell size determines the minimum space a packet can use, thus a packet can effectively use more buffer than its size. -1 to disable cells
                                                                                                                                                                                                                port_max_shared_buffer_use_bits = Str; %port_max_shared_buffer_use_bits ; Maximum shared buffer that each individual port is allowed to use
                                                                                                                                                                                                                }
                                                                                                                                                                                                            }

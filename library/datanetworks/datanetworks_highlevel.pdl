                                minTH = Str; %RED.tmin ; Minimum queueSize threadhold to start discarding packets randomly
                                PminTH = Str; %RED.pmin ; Starting discard probability when queueSize=minTH
                                maxTH = Str; %RED.tmax ; Maximum queueSize threadhold to always discard packets
                                pmaxTH = Str; %RED.pmax ; Maxium discard probability when queueSize=maxTH (0 <= PminTH < PmaxTH <= 1)
                                alpha = Str; %RED.alpha ; The w-avg forgetting factor. Weight of the current sample vs the historical avg
                                }

                                                                                                                                                                                                            {
                                                                                                                                                                                                            Name = RoutingTable
                                                                                                                                                                                                            Ports = 4 ; 4
                                                                                                                                                                                                            Path = network/FlowRouter.h
                                                                                                                                                                                                            Description = In0: Incomming packets\nInN: Outgoing packets\n\nDemultiplexes a N input packet flows into M output packet flows.\nActs as a switch with N inports and M outports\nFor the routing decision it uses the routing table defined in FlowDefinitions.cpp
                                                                                                                                                                                                            Graphic
                                                                                                                                                                                                                {
                                                                                                                                                                                                                Position = -4920 ; 4215
                                                                                                                                                                                                                Dimension = 840 ; 720
                                                                                                                                                                                                                Direction = Right

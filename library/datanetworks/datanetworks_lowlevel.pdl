            Parameters
                {
                }
            }
        Atomic
            {
            Name = flowGenerator
            Ports = 1 ; 1
            Path = network/PacketFlowGenerator.h
            Description = Generates packets using 2 distributions read from parameters: 1) for the packetSize 2) for the interleave time between each packet generation\n inPort0: can receive events that force the generation of a new packet the moment of the event arrival (can be used to generate packets following an outside source distribution)\n outPort0: generated packets
            Graphic
                {
                Position = -2280 ; 3795
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %datanetworks%sink.png
                }
            Parameters
                {
                flowName = Str; flowName ; Name of the flow to retrieve its parameters
                }
            }
        Atomic
            {
            Name = queue
            Ports = 2 ; 2
            Path = network/packetqueue.h
            Description = In0 Incomming packets to queue\nIn1 Incoming signal to request dequeue\nOut0 Outgoing dequeued packets\nOut1 Outgoing queue lenght information\n\nQueues incoming packets and enqueues them as required by a\nexternal entity. FIFO Policy (FirstInFirstOut). Provides information\nits internal state.
            Graphic
                {
                Position = -2280 ; 2595
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %datanetworks%queue.png
                }
            Parameters
                {
                MaxCapacity = Str; Queue.bufferSize ; Queue Capacity in bits. (Use -1 for INF capacity)
                ForcedPeriod = Str; -1 ; Force minimum period to transition. Use -1 for INF
                }
            }
        Atomic
            {
            Name = TCP_RCV
            Ports = 1 ; 1
            Path = network/packettcprcv.h
            Description = TCP Receiver\nReceives TCP packets and sends ACK packets\n\nAplica el mecanismo de control de congestion por ventana deslizante del protocolo TCP, senalizando con paquetes ACK la recepcion del flujo entrante. (Siguiendo [SW94] y [SW95])
            Graphic
                {
                Position = -705 ; 5145
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %datanetworks%server.png
                }
            Parameters
                {
                MSS = Str; TCP.MSS ; 
                ipSender = Str; ipSender ; IP address of the sender (the one of the sender).\nThe string is used directly as IP address. It can not be a variable name as it is not looked in the parameters.
                ipReceiver = Str; ipReceiver ; IP address of the receiver (my IP).\nThe string is used directly as IP address. It can not be a variable name as it is not looked in the parameters.
                portSender = Str; 0 ; TCP port of the sender
                portReceiver = Str; 0 ; TCP port of the receiver (my port)
                }
            }
        Atomic
            {
            Name = TCP_SND
            Ports = 2 ; 2
            Path = network/packettcpsnd.h
            Description = Receives packets from the upper layer (application) and forwards them using a congestion control mechanism of TCP protocol ([SW94] y [SW95])
            Graphic
                {
                Position = -2280 ; 5145
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %datanetworks%tocketbucket.png
                }
            Parameters
                {
                MSS = Str; TCP.MSS ; 
                ipSender = Str; ipSender ; My IP address (the one of the sender).\nThe string is used directly as IP address. It can not be a variable name as it is not looked in the parameters.
                ipReceiver = Str; ipReceiver ; IP address of the receiver.\nThe string is used directly as IP address. It can not be a variable name as it is not looked in the parameters.
                portSender = Str; 0 ; My Port. TCP port of the sender
                portReceiver = Str; 0 ; TCP port of the receiver
                WND_CWND_MAX = Str; TCP.CWND_max ; MAX Congestion Window (in packets) inf==NONE, Typical: 64
                WND_SSTHRESH = Str; TCP.CWND_ssthresh ; Experimental Slow Start, 0==OFF
                RTT_alfa = Str; 0.125 ; Typical value 0.125. RTT_alfa==0 => No moving average for RTT, only instantaneous measurements
                T_RTT = Str; TCP.RTT_initial ; Initial Calculated Round Trip Time
                DUP_ACK_LIMIT = Str; 3 ; Typical value 3
                T_FORCED_RTO = Str; -1 ; T_FORCED_RTO>=0 => Forces RTO instead of calculating it
                INTERPACKET_SND_TIME = Str; 0 ; It should look like "instantaneous" compared to RTT, maybe RTT/1000 is a good rule of thumb
                INTER_REQ_TIME = Str; 1e-7 ; Should look like "instantaneous" compared to RTT, maybe RTT/1000 is a good rule of thumb
                }
            }

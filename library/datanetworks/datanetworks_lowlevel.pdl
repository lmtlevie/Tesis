                                                        maxTH = Str; RED.tmax ; Maximum queueSize threadhold to always discard packets
                                                        pmaxTH = Str; RED.pmax ; Maxium discard probability when queueSize=maxTH (0 <= PminTH < PmaxTH <= 1)

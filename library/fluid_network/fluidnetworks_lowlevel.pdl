                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Coupled
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    Type = Coordinator
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    Name = boundInt

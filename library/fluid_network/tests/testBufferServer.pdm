            Description = A slightly different TCP version that takes in dropRate(t) instead of REDDiscardProb(t) \n\nin0: queueingDelay(t)\nin1: dropRate(t)\n\nout0: TCPWindowSize_pkts W(t)\nout1: pkts/sec\n\n see https:/ /modsimu.exp.dc.uba.ar\/redmine/projects/modelos-fluidos-de-redes/wiki/Changing_discardProb_for_discardRate\n
            Graphic
                {
                Position = -23625; -4035
                Dimension = 2115; 1020
                Direction = Right
                Color = 15
                Icon = %continous_network%host_tcp.jpg
                Window = 5000; 5000; 5000; 5000
                }
            Parameters
                {
                maxWindow = Str; 9999999 ; maximum TCP window size
                initialDelay = Str; 0 ; history for the delay
                dropCalib = Str; [1, 1, 1] ; calibration for the drop rate
                meanPacketSize = Str; 4000 ; maximum TCP window size
                onOffTimeChanges = Str; 0 ; turn continuous TCP on off (time changes)
                onOffValueChanges = Str; 1 ; turn continuous TCP on off (0 off, 1 on)
                NTimeChanges = Str; [0, 10, 20] ; number of TCP sessions in the host (times of change)
                NValueChanges = Str; [40,10,40] ; number of TCP sessions in the host (value for N)
                linkCapacity = Str; 100e6 ; maximum TCP window size
                linkDelay = Str; 0.0001 ; 
                dQmin = Str; 1e-3 ; 
                dQrel = Str; 1e-6 ; 
                }

Coupled
    {
    Type = Root
    Name = Sinks
    Ports = 0; 0
    Description = Sink Elements
    Graphic
        {
        Position = 0; 0
        Dimension = 660; 660
        Direction = Right
        Color = 15
        Icon = %sinks%sink.bmp
        Window = 5000; 5000; 5000; 5000
        }
    Parameters
        {
        }
    System
        {
        Atomic
            {
            Name = GnuPlot
            Ports = 1 ; 0
            Path = sinks/gnuplot.h
            Description = Plot input signal using GnuPlot
            Graphic
                {
                Position = 5220 ; 240
                Dimension = 675 ; 720
                Direction = Right
                Color = 15
                Icon = %sinks%gnuplot.svg
                }
            Parameters
                {
                Inputs = Str; %Inputs ; Number of inputs
                Format = Str; set xrange [0:%tf] @ set grid @ set title 'Plot' ; General Formatting (use @ as line break)
                Format1 = Str; with lines title 'First output' ; Formatting options for input 1
                Format2 = Str;  ; Formatting options for input 2
                Format3 = Str;  ; Formatting options for input 3
                Format4 = Str;  ; Formatting options for input 4
                Format5 = Str;  ; Formatting options for input 5
                }
            }
        Atomic
            {
            Name = To Disk
            Ports = 1 ; 0
            Path = sinks\to_disk.h
            Description = Save the values (event,t) in a file.
            Graphic
                {
                Position = 1320 ; 270
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %sinks%todisk.svg
                }
            Parameters
                {
                File = Str; output.csv ; file name
                }
            }
        Atomic
            {
            Name = To Workspace
            Ports = 1 ; 0
            Path = sinks/toscilab_offline.h
            Description = Sends input signal to Scilab Workspace
            Graphic
                {
                Position = 195 ; 1995
                Dimension = 675 ; 675
                Direction = Right
                Color = 15
                Icon = %sources%workspace.bmp
                }
            Parameters
                {
                Time variable = Str; t ; 
                Signal = Str; y ; 
                }
            }
        Coupled
            {
            Type = Coordinator
            Name = QSSSampleLogger
            Ports = 1; 0
            Description = Sends input QSS signals  to the Logger set in configuration (Scilab, cvs, etc).\nAlso records a period sample of the QSS signal
            Graphic
                {
                Position = -1755; 15
                Dimension = 675; 720
                Direction = Right
                Color = 15
                Icon = %sinks%sink.bmp
                Window = 5000; 5000; 5000; 5000
                }
            Parameters
                {
                samplingPeriod = Str; 0.1 ; QSS signal will be sampled and logged using this time period
                }
            System
                {
                Inport
                    {
                    Name = Inport0
                    CoupledPort = 1
                    Description = 
                    Graphic
                        {
                        Position = -6240 ; 6675
                        Dimension = 480
                        Direction = Right
                        }
                    }
                Atomic
                    {
                    Name = sample2plot
                    Ports = 1 ; 1
                    Path = qss/samplehold.h
                    Description = Sample and hold
                    Graphic
                        {
                        Position = -4080 ; 6270
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %hybrid%samphold.svg
                        }
                    Parameters
                        {
                        T = Str; %samplingPeriod ; Sampling period (Scilab expression)
                        phi = Str; 0 ; Delay (Scilab expression)
                        }
                    }
                Atomic
                    {
                    Name = sampledValue
                    Ports = 1 ; 0
                    Path = sink/toLogger.h
                    Description = Sends input QSS signals to the Logger set in configuration (Scilab, cvs, etc)
                    Graphic
                        {
                        Position = -2085 ; 6285
                        Dimension = 735 ; 645
                        Direction = Right
                        Color = 15
                        Icon = %sinks%sink.bmp
                        }
                    Parameters
                        {
                        }
                    }
                Atomic
                    {
                    Name = value
                    Ports = 1 ; 0
                    Path = sink/toLogger.h
                    Description = Sends input QSS signals to the Logger set in configuration (Scilab, cvs, etc)
                    Graphic
                        {
                        Position = -4035 ; 7635
                        Dimension = 735 ; 645
                        Direction = Right
                        Color = 15
                        Icon = %sinks%sink.bmp
                        }
                    Parameters
                        {
                        }
                    }
                Point
                    {
                    ConectedLines = 2 ; 3 ; 4
                    ConectedExtrems = Org ; Org ; Org
                    Position = -4755 ; 6675
                    }
                Line
                    {
                    Source = Cmp ;  1 ;  1 ; 0
                    Sink = Cmp ;  2 ;  1 ; -1
                    PointX = -3300 ; -3300 ; -2265
                    PointY = 6600 ; 6600 ; 6600
                    }
                Line
                    {
                    Source = Prt ;  1 ;  1 ; 0
                    Sink = Pnt ;  1 ; -1 ; 0
                    PointX = -5625 ; -5625 ; -4755
                    PointY = 6675 ; 6675 ; 6675
                    }
                Line
                    {
                    Source = Pnt ;  1 ; -1 ; 0
                    Sink = Cmp ;  1 ;  1 ; -1
                    PointX = -4755 ; -4215 ; -4215
                    PointY = 6675 ; 6675 ; 6600
                    }
                Line
                    {
                    Source = Cmp ;  3 ;  1 ; -1
                    Sink = Pnt ;  1 ; -1 ; 0
                    PointX = -4215 ; -4755 ; -4755
                    PointY = 7950 ; 7950 ; 6675
                    }
                }
            }
                Atomic
                    {
                    Name = Event Counter
                    Ports = 1 ; 0
                    Path = sinks/ev_count2.h
                    Description = Saves in a file the number of events received at each port.
                    Graphic
                        {
                        Position = 2490 ; 270
                        Dimension = 720 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%coun_ev.bmp
                        }
                    Parameters
                        {
                        File = Str; num_ev.txt ; file name
                        Inputs = Str; %Inputs ; Number of Inputs
                        }
                    }
                Atomic
                    {
                    Name = LPT Write
                    Ports = 1 ; 0
                    Path = sinks/writelpt.h
                    Description = Writes the values received in the LPT1.
                    Graphic
                        {
                        Position = 2145 ; 1845
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%parallel.gif
                        }
                    Parameters
                        {
                        }
                    }
                Atomic
                    {
                    Name = ToWav
                    Ports = 1 ; 0
                    Path = sinks\towav.h
                    Description = Writes the input signal into a PCM wave file
                    Graphic
                        {
                        Position = 5295 ; 1845
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%wav-icon.jpg
                        }
                    Parameters
                        {
                        Filename = Str; output.wav ; 
                        Sample Rate = Lst; 1%44100%22050% ; 
                        }
                    }
                Atomic
                    {
                    Name = Time counter
                    Ports = 0 ; 0
                    Path = sinks\time_count.h
                    Description = Elapsed time counter. Saves in a file the elepsed time from the beginning of the simulation until t=tf
                    Graphic
                        {
                        Position = 3795 ; 270
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%clock.svg
                        }
                    Parameters
                        {
                        file = Str; eltime.txt ; Output file
                        tf = Val; 9.999 ; Final time.
                        }
                    }
                Atomic
                    {
                    Name = Scilab Command
                    Ports = 1 ; 0
                    Path = hybrid\runscilabjob.h
                    Description = Runs Scilab commands at Init, Exit and when receive events.
                    Graphic
                        {
                        Position = 3795 ; 1995
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%scilab.ico
                        }
                    Parameters
                        {
                        Run at Init = Str; a=0 ; Scilab Job at Init
                        Run at External = Str; a=a+1 ; Scilab Job when receive event
                        Run at Exit = Str; b=a ; Scilab Job at Exit
                        }
                    }
                Atomic
                    {
                    Name = QSSLogger
                    Ports = 1 ; 0
                    Path = sink/toLogger.h
                    Description = Sends input QSS signals to the Logger set in configuration (Scilab, cvs, etc)
                    Graphic
                        {
                        Position = -1935 ; 2235
                        Dimension = 735 ; 645
                        Direction = Right
                        Color = 15
                        Icon = %sinks%sink.bmp
                        }
                    Parameters
                        {
                        }
                    }
                Atomic
                    {
                    Name = GnuPlotXY
                    Ports = 2 ; 0
                    Path = sink/gnuplotxy2.h
                    Description = Plot input signal using GnuPlot. This plot takes advantage of the QSS signals, therefore it doesn't need them to pass through a sample&hold block.
                    Graphic
                        {
                        Position = -1455 ; 4515
                        Dimension = 675 ; 720
                        Direction = Right
                        Color = 15
                        Icon = %sinks%gnuplot.svg
                        }
                    Parameters
                        {
                        Format = Str; set xrange [-2:2] @ set yrange [-2:2] @ set grid @ set title 'Plot XY' ; General Formatting (use @ as line break)
                        Format1 = Str; with linespoints title 'xy' ; Formatting options
                        }
                    }
                Atomic
                    {
                    Name = GnuPlotXYZ
                    Ports = 3 ; 0
                    Path = sink/gnuplotxyz2.h
                    Description = Plot input signal using GnuPlot. This plot takes advantage of the QSS signals, therefore it doesn't need them to pass through a sample&hold block.
                    Graphic
                        {
                        Position = 795 ; 4920
                        Dimension = 675 ; 675
                        Direction = Right
                        Color = 15
                        Icon = %sinks%gnuplot.svg
                        }
                    Parameters
                        {
                        Format = Str; set xrange [-2:2] @ set yrange [-2:2] @ set zrange [-2:2] @ set grid @ set title 'Plot XYZ' ; General Formatting (use @ as line break)
                        Format1 = Str; with linespoints title 'xyz' ; Formatting options
                        }
                    }
        }
    }
